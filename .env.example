# Public read-only Supabase connection. Never use the service key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_SITE_URL=https://your-publication-domain.example

# Server-only settings. Generate EDITOR_SECRET with: openssl rand -hex 32
SUPABASE_SERVICE_ROLE_KEY=
EDITOR_SECRET=
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
AUTO_PUBLISH=true

# Email forwarding, using a private, unpredictable receiving alias.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_EMAIL_ADDRESS=
INBOUND_ALLOWED_SENDERS=

# Optional queue recovery scheduler and public corrections contact.
CRON_SECRET=
CORRECTIONS_EMAIL=
